# Copy to .env and fill in. NEVER commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Shared secret between Express and this service. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RAG_SERVICE_SECRET=

# MongoDB Atlas
MONGO_URI=
MONGO_DB_NAME=sahyog_rag

# Gemini
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Google Drive (OAuth Desktop client)
GOOGLE_CREDENTIALS_PATH=./secrets/credentials.json
GOOGLE_TOKEN_PATH=./secrets/token.json
DRIVE_ROOT_FOLDER_ID=
DRIVE_INTERACTIVE_AUTH=true
MAX_DOWNLOAD_MB=50

# Local folder ingestion (recursive; project-relative or absolute path)
LOCAL_KNOWLEDGE_DIR=./knowledge

# OCR (Windows example; leave blank if tesseract is on PATH)
TESSERACT_CMD=
OCR_ENABLED=true

# Chunking (approximate tokens)
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# Retrieval
SEARCH_TOP_K=5
# Set false to use the approved-only MongoDB keyword index without Gemini query embeddings.
VECTOR_SEARCH_ENABLED=true
# Set true ONLY if the Drive files are shared so students can open them.
LINK_VISIBLE=false

# Require admin approval before newly indexed documents are visible to students.
AUTO_APPROVE=false

# Scheduled sync is run by a single external Cron Job (see docs/DEPLOYMENT.md).
AUTO_SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=360

# Embedding request pacing (free-tier friendly)
EMBED_BATCH_SIZE=16
EMBED_MIN_INTERVAL_S=0.7
